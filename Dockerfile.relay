# Stage 1: Build
FROM golang:1.25-alpine AS build
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o bizeto-relay ./cmd/relay

# Stage 2: Final
FROM alpine:latest
WORKDIR /app

# Fase 4: Docker Non-Root User
RUN adduser -D -u 1000 bizeto
COPY --from=build --chown=bizeto:bizeto /app/bizeto-relay .

# Create data dir and set ownership
RUN mkdir -p /app/data && chown -R bizeto:bizeto /app/data

USER bizeto

EXPOSE 80 443 4321 8080
CMD ["./bizeto-relay"]
